# --- Placa ESP32-S3-N16R8: 16 MB de flash, 8 MB de PSRAM octal
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# --- FreeRTOS a 1 kHz: la rampa V/f corre cada 1 ms
CONFIG_FREERTOS_HZ=1000

# --- Consola por el USB nativo (puerto USB del ESP32-S3)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# --- MCPWM: ISR y funciones de control en IRAM (la ISR de la SPWM corre
#     a 10 kHz a 25,2 kHz y no puede esperar a la caché de la flash)
CONFIG_MCPWM_ISR_IRAM_SAFE=y
CONFIG_MCPWM_CTRL_FUNC_IN_IRAM=y
CONFIG_GPIO_CTRL_FUNC_IN_IRAM=y
CONFIG_ADC_CONTINUOUS_ISR_IRAM_SAFE=y

# --- LVGL 9
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_USE_OS_NONE=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_DEF_REFR_PERIOD=20
CONFIG_LV_USE_DEMO_WIDGETS=n
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_USE_LOG=n
CONFIG_LV_MEM_SIZE_KILOBYTES=96

# --- Optimización para rendimiento
CONFIG_COMPILER_OPTIMIZATION_PERF=y
